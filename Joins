SELECT *FROM customer;

SELECT *FROM 
customer c 
INNER JOIN orders o 
ON c.customer_id = o.customer_id;


SELECT *FROM 
customer as A LEFT JOIN 
orders as B 
ON A.customer_id =B.customer_id 
WHERE B.customer_id IS NULL ;



SELECT *FROM orders
WHERE amount >(
SELECT AVG(amount)
FROM orders
);



CREATE VIEW view1 AS 
SELECT customer_id , name FROM customer;

